{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "jsx": "react-jsx", "strict": true, "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/src/*"] }, "types": ["vite/client"]
  },
  "include": ["src/renderer/src", "src/preload", "electron.vite.config.ts"]
}
